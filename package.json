{
  "name": "numerology",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "content:schemas": "npm run schemas -w @numerology/content",
    "content:lint": "npm run lint -w @numerology/content-pipeline",
    "content:snapshot": "npm run snapshot -w @numerology/content-pipeline",
    "content:release": "npm run release -w @numerology/content-pipeline",
    "content:gate": "npm run gate -w @numerology/content-pipeline",
    "dev": "npm run content:release && npm run dev -w @numerology/web",
    "build": "npm run content:release && npm run build -w @numerology/web",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm run test && npm run content:lint && npm run build && npm run e2e",
    "content:diff": "npm run diff -w @numerology/content-pipeline",
    "content:draft": "npm run draft -w @numerology/content-pipeline --",
    "content:sheet": "npm run sheet -w @numerology/content-pipeline --"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2",
    "serve": "^14.2.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
